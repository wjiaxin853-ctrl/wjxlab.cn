[Unit]
Description=WJX Portfolio Document Assistant
After=network.target

[Service]
Type=simple
DynamicUser=yes
WorkingDirectory=/opt/wjx-portfolio-assistant
ExecStart=/usr/bin/python3 -B /opt/wjx-portfolio-assistant/server.py
Restart=on-failure
RestartSec=2
TimeoutStopSec=5
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=128M

[Install]
WantedBy=multi-user.target
